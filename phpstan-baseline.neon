parameters:
	ignoreErrors:
		-
			message: '#^Cannot unset offset ''assets'' on string\.$#'
			identifier: unset.offset
			count: 1
			path: src/Handler.php

		-
			message: '#^Method iqual\\Composer\\ProjectScaffold\\Operations\\AbstractOperation\:\:generateContents\(\) invoked with 1 parameter, 0 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Operations/AbstractOperation.php

		-
			message: '#^Access to an undefined property iqual\\Composer\\ProjectScaffold\\Operations\\OperationData\:\:\$destination\.$#'
			identifier: property.notFound
			count: 1
			path: src/Operations/OperationData.php

		-
			message: '#^Class iqual\\Composer\\ProjectScaffold\\Operations\\AddOperation referenced with incorrect case\: iqual\\Composer\\ProjectScaffold\\Operations\\addOperation\.$#'
			identifier: class.nameCase
			count: 2
			path: src/Operations/OperationFactory.php

		-
			message: '#^Class iqual\\Composer\\ProjectScaffold\\Operations\\MergeOperation referenced with incorrect case\: iqual\\Composer\\ProjectScaffold\\Operations\\mergeOperation\.$#'
			identifier: class.nameCase
			count: 1
			path: src/Operations/OperationFactory.php

		-
			message: '#^Class iqual\\Composer\\ProjectScaffold\\Options\\ScaffoldOptions constructor invoked with 1 parameter, 3 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Options/ScaffoldOptions.php

		-
			message: '#^Constructor of class iqual\\Composer\\ProjectScaffold\\Util\\ContentMerger has an unused parameter \$default_data\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: src/Util/ContentMerger.php

		-
			message: '#^Method iqual\\Composer\\ProjectScaffold\\Util\\ContentMerger\:\:mergeContents\(\) should return string but return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: src/Util/ContentMerger.php

		-
			message: '#^Variable \$message on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 2
			path: src/Util/Interpolator.php
