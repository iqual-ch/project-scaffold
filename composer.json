{
  "name": "iqual/project-scaffold",
  "description": "Interactive project scaffolding and initializing.",
  "type": "composer-plugin",
  "keywords": ["scaffold", "kickstart", "init", "bootstrap", "template"],
  "homepage": "https://www.iqual.ch",
  "license": "GPL-2.0-or-later",
  "authors": [
      {
          "name": "martinstadelmann",
          "email": "m.stadelmann@iqual.ch"
      }
  ],
  "require": {
    "php": "^8.3",
    "composer-plugin-api": "^2.0",
    "symfony/yaml": "^6.4 || ^7.0",
    "twig/twig": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "iqual\\Composer\\ProjectScaffold\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "iqual\\Composer\\ProjectScaffold\\Tests\\": "tests/src"
    }
  },
  "extra": {
    "class": "iqual\\Composer\\ProjectScaffold\\Plugin"
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "composer/composer": "^2.6",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.5 || ^11.0",
    "symfony/process": "^6.4 || ^7.0"
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:functional": "phpunit --testsuite functional",
    "phpstan": "phpstan analyse"
  }
}
